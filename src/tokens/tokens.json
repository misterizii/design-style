{
  "name": "misterizii style — Langit Malam",
  "color": {
    "navy": { "950": "#0B1027", "900": "#131B3A", "800": "#1E2850", "700": "#2C3866", "400": "#8A93B4" },
    "mango": { "600": "#F29F00", "500": "#FFB52E", "100": "#FFF1D4" },
    "sky": { "500": "#5B8DEF", "100": "#E3ECFD" },
    "mist": { "200": "#DFE5F3", "100": "#EEF2FB", "50": "#F6F8FD" },
    "slate": { "500": "#5A6280" },
    "green": { "500": "#22A06B" },
    "red": { "500": "#E5484D" },
    "white": "#FFFFFF"
  },
  "font": {
    "family": "Plus Jakarta Sans",
    "weights": [400, 500, 700, 800],
    "source": "https://fonts.google.com/specimen/Plus+Jakarta+Sans",
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "2xl": "2rem",
      "3xl": "2.75rem",
      "4xl": "3.5rem"
    },
    "leading": { "tight": 1.1, "snug": 1.3, "normal": 1.6 },
    "tracking": { "tight": "-0.02em", "label": "0.12em" }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "full": "999px" },
  "canvas": {
    "carousel": { "ratio": "4:5", "export": [1080, 1350] },
    "reels": { "ratio": "9:16", "export": [1080, 1920], "safeInset": { "top": "9%", "right": "15%", "bottom": "21%", "left": "7%" } },
    "slide": { "ratio": "16:9", "export": [1920, 1080] }
  },
  "usage": {
    "formal": "navy.900 sebagai warna dasar gelap, judul, dan teks",
    "ceria": "mango.500 untuk satu kata kunci, tombol utama di latar navy, dan penanda nomor",
    "bersih": "white dan mist.100 sebagai latar terang",
    "pendukung": "sky.500 secukupnya untuk info dan ilustrasi",
    "benar-salah": "green.500 dan red.500 hanya untuk menandai jawaban benar/salah, bukan sebagai warna dekorasi"
  }
}
